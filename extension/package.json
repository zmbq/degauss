{
  "name": "vscode-retro",
  "displayName": "Retro Looks",
  "description": "Vintage computer looks for VS Code and Windows Terminal: Apple //e green and amber and IBM 3270 ISPF, with period fonts. Windows Terminal also gets IBM PS/2 VGA.",
  "version": "0.1.1",
  "publisher": "zmbq",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zmbq/vscode-retro"
  },
  "bugs": {
    "url": "https://github.com/zmbq/vscode-retro/issues"
  },
  "homepage": "https://github.com/zmbq/vscode-retro#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "retro",
    "vintage",
    "apple ii",
    "apple //e",
    "ibm",
    "vga",
    "3270",
    "ispf",
    "mainframe",
    "green screen",
    "amber",
    "font",
    "windows terminal"
  ],
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Apple //e",
        "uiTheme": "vs-dark",
        "path": "./generated/themes/apple2e.json"
      },
      {
        "label": "IBM 3270",
        "uiTheme": "vs-dark",
        "path": "./generated/themes/ibm-3270.json"
      },
      {
        "label": "IBM 3270 Monochrome",
        "uiTheme": "vs-dark",
        "path": "./generated/themes/ibm-3270-mono.json"
      }
    ],
    "commands": [
      {
        "command": "retroLooks.choose",
        "title": "Retro: Choose Look…"
      },
      {
        "command": "retroLooks.apply.apple2e",
        "title": "Retro: Apple //e"
      },
      {
        "command": "retroLooks.apply.ibm-3270",
        "title": "Retro: IBM 3270"
      },
      {
        "command": "retroLooks.apply.ibm-3270-mono",
        "title": "Retro: IBM 3270 Monochrome"
      },
      {
        "command": "retroLooks.setColor",
        "title": "Retro: Set Phosphor Color…"
      },
      {
        "command": "retroLooks.off",
        "title": "Retro: Off (restore previous look)"
      },
      {
        "command": "retroLooks.install",
        "title": "Retro: Install Fonts and Windows Terminal Profiles"
      },
      {
        "command": "retroLooks.uninstall",
        "title": "Retro: Uninstall Fonts and Windows Terminal Profiles"
      },
      {
        "command": "retroLooks.openFonts",
        "title": "Retro: Open Bundled Fonts Folder"
      }
    ],
    "configuration": {
      "title": "Retro Looks",
      "properties": {
        "retroLooks.pixelPerfectFontSize": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Adjust the font size of pixel fonts to your display scaling so every font pixel covers a whole number of screen pixels. This keeps them sharp; turn it off to use each look's nominal size."
        },
        "retroLooks.phosphorColors": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "The phosphor color of each monochrome look in VS Code, by look ID (`apple2e`, `ibm-3270-mono`): a preset (`green`, `amber`, `white`, `cyan`, `yellow`) or `#RRGGBB`. Easiest to set with **Retro: Set Phosphor Color…**. Windows Terminal is not affected."
        }
      }
    }
  }
}
