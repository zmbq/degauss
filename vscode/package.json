{
  "name": "degauss",
  "displayName": "Degauss: Retro Computer Looks",
  "description": "Vintage computer looks for VS Code and Windows Terminal: Apple //e green and amber and IBM 3270 ISPF, with period fonts. Windows Terminal also gets IBM PS/2 VGA.",
  "version": "0.3.0",
  "publisher": "zmbq",
  "license": "MIT",
  "icon": "icon.png",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/zmbq/degauss"
  },
  "bugs": {
    "url": "https://github.com/zmbq/degauss/issues"
  },
  "homepage": "https://github.com/zmbq/degauss#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "retro",
    "vintage",
    "apple ii",
    "apple //e",
    "ibm",
    "vga",
    "3270",
    "ispf",
    "mainframe",
    "green screen",
    "amber",
    "font",
    "windows terminal"
  ],
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "vscode:uninstall": "node ./uninstall.js"
  },
  "contributes": {
    "themes": [
      {
        "label": "Apple //e",
        "uiTheme": "vs-dark",
        "path": "./generated/themes/apple2e.json"
      },
      {
        "label": "IBM 3270",
        "uiTheme": "vs-dark",
        "path": "./generated/themes/ibm-3270.json"
      },
      {
        "label": "IBM 3270 Monochrome",
        "uiTheme": "vs-dark",
        "path": "./generated/themes/ibm-3270-mono.json"
      }
    ],
    "commands": [
      {
        "command": "degauss.choose",
        "title": "Degauss: Choose Look…"
      },
      {
        "command": "degauss.apply.apple2e",
        "title": "Degauss: Apple //e"
      },
      {
        "command": "degauss.apply.ibm-3270",
        "title": "Degauss: IBM 3270"
      },
      {
        "command": "degauss.apply.ibm-3270-mono",
        "title": "Degauss: IBM 3270 Monochrome"
      },
      {
        "command": "degauss.setColor",
        "title": "Degauss: Set Phosphor Color…"
      },
      {
        "command": "degauss.off",
        "title": "Degauss: Off (restore previous look)"
      },
      {
        "command": "degauss.degauss",
        "title": "Degauss: Degauss!"
      },
      {
        "command": "degauss.install",
        "title": "Degauss: Install Fonts"
      },
      {
        "command": "degauss.openFonts",
        "title": "Degauss: Open Bundled Fonts Folder"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "degauss.install",
          "when": "!degauss.fontsInstalled"
        }
      ]
    },
    "configuration": {
      "title": "Degauss",
      "properties": {
        "degauss.pixelPerfectFontSize": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Adjust the font size of pixel fonts to your display scaling so every font pixel covers a whole number of screen pixels. This keeps them sharp; turn it off to use each look's nominal size."
        },
        "degauss.phosphorColors": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "The phosphor color of each monochrome look in VS Code, by look ID (`apple2e`, `ibm-3270-mono`): a preset (`green`, `amber`, `white`, `cyan`, `yellow`) or `#RRGGBB`. Easiest to set with **Degauss: Set Phosphor Color…**. Windows Terminal is not affected."
        }
      }
    }
  }
}
